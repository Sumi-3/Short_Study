{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "types": [
      "node",
      "react"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true
  },
  "include": [
    "src",
    "web/src"
  ],
  "exclude": [
    "remotion.config.ts",
    "web/vite.config.ts",
    "node_modules",
    "out",
    "web/dist",
    "build"
  ]
}

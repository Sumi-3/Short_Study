# 必須: 台本生成
ANTHROPIC_API_KEY=sk-ant-...
# 任意: 台本生成に使うモデル
ANTHROPIC_MODEL=claude-opus-5
# identity-linked なキー（個人アカウント紐付け）を使うときだけ必要。
# "anthropic-workspace-id is required..." と 400 が返る場合はこれを設定する。
# ワークスペース専用キーを作れば不要。
ANTHROPIC_WORKSPACE_ID=

# TTS プロバイダー: edge (無料・デフォルト) | elevenlabs
TTS_PROVIDER=edge
# EdgeTTS の日本語ボイスは2種類: ja-JP-NanamiNeural (女性) / ja-JP-KeitaNeural (男性)
EDGE_VOICE=ja-JP-NanamiNeural
EDGE_RATE=+8%
# ピッチ・音量は相対指定 ("+10%" / "-2st" / "+20Hz")
EDGE_PITCH=+0%
EDGE_VOLUME=+0%

# TTS_PROVIDER=elevenlabs のときだけ必要
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# 字幕タイミングの取得元
#   tts     … EdgeTTS の word boundary を流用。台本の文字がそのまま出るので日本語はこちらが正確（デフォルト）
#   whisper … 音声から書き起こす。TTS_PROVIDER=elevenlabs のときは必須
CAPTION_SOURCE=tts
# CAPTION_SOURCE=whisper のとき。日本語なので多言語モデル (medium 推奨 / small は速いが精度低め)
WHISPER_MODEL=medium
WHISPER_VERSION=1.5.5

# --- デプロイ時のみ ---
# 生成物の書き込み先。Vercel は /tmp 以外が読み取り専用なので /tmp を指定する。
# 未設定ならリポジトリ直下 (public/projects/) に書く＝ローカルの従来どおり。
SHORT_STUDY_DATA_DIR=
# Vercel Blob ストアを作ると自動で入る。これが入っていると生成物が Blob に上がり、
# manifest の音声パスが絶対URLになる。空ならローカルのディスクを使う。
BLOB_READ_WRITE_TOKEN=

# 動画の目安の長さ(秒)。台本のシーン数のヒントになる
TARGET_SECONDS=50
SCENE_PADDING_SECONDS=0.35

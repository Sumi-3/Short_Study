# 必須: 台本生成
ANTHROPIC_API_KEY=sk-ant-...
# 任意: 台本生成に使うモデル
ANTHROPIC_MODEL=claude-opus-5
# identity-linked なキー（個人アカウント紐付け）を使うときだけ必要。
# "anthropic-workspace-id is required..." と 400 が返る場合はこれを設定する。
# ワークスペース専用キーを作れば不要。
ANTHROPIC_WORKSPACE_ID=

# TTS プロバイダー: edge (無料・デフォルト) | elevenlabs
TTS_PROVIDER=edge
# EdgeTTS の日本語ボイスは2種類: ja-JP-NanamiNeural (女性) / ja-JP-KeitaNeural (男性)
EDGE_VOICE=ja-JP-NanamiNeural
EDGE_RATE=+8%
# ピッチ・音量は相対指定 ("+10%" / "-2st" / "+20Hz")
EDGE_PITCH=+0%
EDGE_VOLUME=+0%

# TTS_PROVIDER=elevenlabs のときだけ必要
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# 字幕タイミングの取得元
#   tts     … EdgeTTS の word boundary を流用。台本の文字がそのまま出るので日本語はこちらが正確（デフォルト）
#   whisper … 音声から書き起こす。TTS_PROVIDER=elevenlabs のときは必須
CAPTION_SOURCE=tts
# CAPTION_SOURCE=whisper のとき。日本語なので多言語モデル (medium 推奨 / small は速いが精度低め)
WHISPER_MODEL=medium
WHISPER_VERSION=1.5.5

# --- 生成時間のつまみ ---
# 台本を書く前にモデルがどれだけ考えるか: low | medium | high | xhigh | max
# 思考も 1 token ずつ生成される以上そのまま待ち時間になるので、下げれば速くなる。
# ただし思考はモデルが実際に問題を解いている部分でもあり、答えを間違えれば動画ごと無駄、
# 規則違反なら書き直し 1 回ぶん増える。削りすぎるとかえって遅くなる。
# （opus-5 は thinking.budget_tokens を受け付けないため、こちらで制御する）
SCRIPT_EFFORT=medium
# 1 要求の締め切り。既定のままだと SDK は 10 分待ち、しかも timeout を再試行する。
SCRIPT_TIMEOUT_MS=360000
OUTLINE_TIMEOUT_MS=60000
# 1 シーン分の音声合成。最後にデータが届いてからの無音時間で計るので、
# 長いナレーションを合成しているだけの状態は落とさない。
TTS_TIMEOUT_MS=90000
# CAPTION_SOURCE=whisper のときだけ使う。
WHISPER_TIMEOUT_MS=300000
# API 側の再試行回数。上の締め切りに毎回掛かるので、SDK 既定の 2 回からは下げてある。
ANTHROPIC_MAX_RETRIES=1

# --- デプロイ時のみ ---
# 生成物の書き込み先。通常は設定不要:
#   Vercel 上          … 自動で /tmp（唯一書ける場所なので選択の余地がない）
#   ローカル           … リポジトリ直下 (public/projects/)
#   Railway            … Volume のマウントパス（例: /data）
# 別の場所に書かせたいときだけ指定する。
SHORT_STUDY_DATA_DIR=
# Vercel 上の生成では、接続済み Blob store の OIDC（BLOB_STORE_ID）を使う。
# ローカルの `npm run sync:blob` / pre-push から既存動画を上げるには、Vercel Storage の
# token を作成して BLOB_READ_WRITE_TOKEN に入れる。BLOB_STORE_ID 単独ではローカル認証できない。
# ストアは必ず public で作ること（後から変更不可）。
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# 尺は問題に応じて自動決定。TARGET_SECONDS は廃止（設定しても参照しない）。
SCENE_PADDING_SECONDS=0.35
